[Unit]
Description=Go WebSocket Server (GoWS)
After=network.target

[Service]
Type=simple
User=gows
Group=gows

WorkingDirectory=/opt/gows
ExecStart=/opt/gows/gows
Environment=GOWS_CONFIG_PATH=/etc/gows/config.yaml

Restart=always
RestartSec=5

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=gows

[Install]
WantedBy=multi-user.target
